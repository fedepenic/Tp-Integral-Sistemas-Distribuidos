# ============================================================================
# Query Selection
# ============================================================================

# Comma-separated list of queries to include in the generated compose.
# Leave empty (or unset) to run all queries.
# Example: TEST_QUERIES=1,3
TEST_QUERIES=

# ============================================================================
# Watcher Configuration
# ============================================================================

# Set to false to omit the watcher service and disable per-service health servers.
ENABLE_WATCHER=true

# Watcher timing configuration.
WATCH_INTERVAL=15s
PING_TIMEOUT=3s
STARTUP_DELAY=30s

# ============================================================================
# Gateway Configuration
# ============================================================================

# Duration to wait for a disconnected client to reconnect before marking it as abandoned.
CLIENT_DISCONNECT_TIMEOUT=60s

# ============================================================================
# Cleaner Configuration
# ============================================================================

# Set to true to skip cleaning (pass all transactions and accounts through as-is)
SKIP_CLEANING=true

# ============================================================================
# Currency Converter Configuration
# ============================================================================

# Set to true to use hardcoded forex rates (matched to notebook values).
# Set to false to fetch live forex rates from the Frankfurter API.
# Bitcoin rates are always hardcoded regardless of this setting.
USE_HARDCODED_RATES=true

# ============================================================================
# Dataset Configuration
# ============================================================================

# Dataset size to use. Valid values: small, medium.
DATASET=small

# Percentage of dataset to use (0-100)
DATASET_PERCENTAGE=100


# ============================================================================
# Chaos Configuration
# ============================================================================

# Seconds between kills
CHAOS_INTERVAL=15

# Number of random services to kill per interval
CHAOS_SERVICES_PER_INTERVAL=2

# Comma-separated list of docker-compose services or service kinds to never kill.
# Use the base service name to exclude all instances (e.g. usd_filter excludes
# usd_filter_1, usd_filter_2, etc.) or an exact service name to exclude only
# that instance (e.g. usd_filter_2). Empty = kill any.
CHAOS_EXCLUDE=rabbitmq,max_per_bank,avg_per_payment_format,fan_src_filter,fan_in,fan_out,scatter_gather,join_q2,join_q3,joiner_sg,sink

# ============================================================================
# Worker Pool Sizes
# ============================================================================

# Global override for all worker instances
# Set to a value > 0 to apply to ALL scalable nodes below
# Set to 0 to use individual configuration for each worker type
N_WORKERS=0

# Data processing workers
N_CLIENTS=2
N_CLEANERS=2
N_CURRENCY_CONVERTERS=2

# Number of watcher replicas. If N_WORKERS > 0, that global value overrides this.
N_WATCHERS=2

# Aggregation and join workers
N_MAXBANK=2
N_JOIN_Q2=2
N_JOIN_Q3=2
N_SRC_FILTER=2
N_FO=2
N_FI=2
N_SG=2
N_JOINER_SG=2

# Filter and averaging workers
N_AVG_PER_PAY=2
N_USD_FILTER=2
N_AMT50_FILTER=2
N_PERIOD2_FILTER=2
N_PERIOD1_FILTER=2
N_AMT_AVG_FILTER=2
N_PERIOD1_Q5_FILTER=2
N_WIREACH_FILTER=2
N_USD_LOWER_THAN_ONE=2
