# ============================================================================
# Query Selection
# ============================================================================

# Comma-separated list of queries to include in the generated compose.
# Leave empty (or unset) to run all queries.
# Example: TEST_QUERIES=1,3
TEST_QUERIES=

# ============================================================================
# Cleaner Configuration
# ============================================================================

# Set to true to skip cleaning (pass all transactions and accounts through as-is)
SKIP_CLEANING=true

# ============================================================================
# Currency Converter Configuration
# ============================================================================

# Set to true to use hardcoded forex rates (matched to notebook values).
# Set to false to fetch live forex rates from the Frankfurter API.
# Bitcoin rates are always hardcoded regardless of this setting.
USE_HARDCODED_RATES=true

# ============================================================================
# Dataset Configuration
# ============================================================================

# Percentage of dataset to use (0-100)
DATASET_PERCENTAGE=10

# Input data files
TRANSACTIONS_FILE=LI-Small_Trans.csv
ACCOUNTS_FILE=LI-Small_accounts.csv


# ============================================================================
# Chaos Configuration
# ============================================================================

# Seconds between kills
CHAOS_INTERVAL=15

# Comma-separated list of services to never kill (empty = kill any)
CHAOS_EXCLUDE=rabbitmq,gateway,watcher,client_1,client_2

# ============================================================================
# Worker Pool Sizes
# ============================================================================

# Global override for all worker instances
# Set to a value > 0 to apply to ALL scalable nodes below
# Set to 0 to use individual configuration for each worker type
N_WORKERS=0

# Data processing workers
N_CLIENTS=2
N_CLEANERS=2
N_CURRENCY_CONVERTERS=2

# Aggregation and join workers
N_MAXBANK=2
N_JOIN_Q2=2
N_JOIN_Q3=2
N_SRC_FILTER=2
N_FO=2
N_FI=2
N_SG=2
N_JOINER_SG=2

# Filter and averaging workers
N_AVG_PER_PAY=2
N_USD_FILTER=2
N_AMT50_FILTER=2
N_PERIOD2_FILTER=2
N_PERIOD1_FILTER=2
N_AMT_AVG_FILTER=2
N_PERIOD1_Q5_FILTER=2
N_WIREACH_FILTER=2
N_USD_LOWER_THAN_ONE=2
